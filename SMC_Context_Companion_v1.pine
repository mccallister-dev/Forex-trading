//@version=6
indicator("SMC Context Companion v1.2", shorttitle = "SMC Sessions", overlay = true, max_bars_back = 1000, max_lines_count = 150, max_labels_count = 150, max_boxes_count = 40)
// Independent context indicator. No ORB logic, orders, dashboard or performance claims.
// Original mechanical definitions; not a reproduction of a creator's trading method.
// Confirmed pivots are used only AFTER their right-hand bars have completed.

const string GH = "01 | Higher-timeframe context"
const string GS = "02 | Chart structure and liquidity"
const string GZ = "03 | Chart-timeframe zones"
const string GV = "04 | Clean display and retention"

string htf1 = input.timeframe("60", "Higher timeframe 1", group = GH)
string htf2 = input.timeframe("240", "Higher timeframe 2", group = GH)
int htfPivot = input.int(3, "HTF swing confirmation bars each side", minval = 1, maxval = 20, group = GH, tooltip = "3 on H4 means a swing is confirmed three H4 candles later. No marks are backdated to make it look known at the peak.")
bool showContext = input.bool(true, "Show one H1/H4 context label (no dashboard)", group = GH)
bool showRange = input.bool(true, "Show latest HTF range and 50% level", group = GH)
string rangeSource = input.string("HTF 2", "Range source", options = ["HTF 1", "HTF 2"], group = GH)
bool shadeRange = input.bool(false, "Shade premium / discount halves", group = GH)
int rangeLength = input.int(80, "Maximum visible HTF range length (chart bars)", minval = 10, maxval = 400, group = GH)

int pivotLength = input.int(3, "Chart swing confirmation bars each side", minval = 1, maxval = 20, group = GS)
float breakBuffer = input.float(0.05, "Structure close buffer (ATR)", minval = 0, maxval = 2, step = 0.05, group = GS)
bool showShift = input.bool(true, "Show CHoCH (opposite structure break)", group = GS)
bool showBos = input.bool(false, "Show BOS and initial breaks", group = GS)
bool showSweeps = input.bool(true, "Show confirmed swing sweeps", group = GS)
float sweepBuffer = input.float(0.05, "Sweep distance beyond swing (ATR)", minval = 0, maxval = 2, step = 0.05, group = GS)
bool showLiquidity = input.bool(false, "Show latest unswept chart swing levels", group = GS)
int swingLife = input.int(300, "Maximum chart swing age after confirmation (bars)", minval = 10, maxval = 900, group = GS)

bool showOb = input.bool(true, "Show chart order-block proxies", group = GZ)
bool showFvg = input.bool(false, "Show chart fair value gaps", group = GZ)
int zoneCount = input.int(1, "Maximum zones per type per direction", minval = 1, maxval = 4, group = GZ, tooltip = "1 = at most one bullish OB, one bearish OB, one bullish FVG and one bearish FVG. FVGs are off initially.")
int obLookback = input.int(12, "Opposing-candle search before structure break", minval = 1, maxval = 50, group = GZ)
string obBounds = input.string("Full candle", "Order-block boundaries", options = ["Full candle", "Body only"], group = GZ)
float displacement = input.float(0.6, "Displacement body / ATR", minval = 0, maxval = 3, step = 0.1, group = GZ)
float bodyFraction = input.float(0.5, "Minimum displacement body / candle range", minval = 0.1, maxval = 1, step = 0.05, group = GZ)
float gapMinimum = input.float(0.05, "Minimum FVG width / ATR", minval = 0, maxval = 2, step = 0.05, group = GZ)
int zoneLife = input.int(150, "Maximum zone age (chart bars)", minval = 5, maxval = 900, group = GZ)
string mitigation = input.string("Close through far edge", "Remove zone when", options = ["Close through far edge", "Wick reaches far edge", "First touch"], group = GZ)
bool showReactions = input.bool(false, "Mark first confirmed zone rejection (not entry signals)", group = GZ)
string reactionFilter = input.string("Annotate only", "HTF rule for optional rejection marks", options = ["Annotate only", "Both HTFs agree"], group = GZ, tooltip = "Does not hide structure, sweeps or zones. Annotate only allows you to see counter-HTF reactions too.")

int retainDays = input.int(3, "Keep drawings (observed trading days)", minval = 1, maxval = 20, group = GV)
string retentionZone = input.string("Africa/Johannesburg", "Trading-day timezone", group = GV)
int eventLimit = input.int(24, "Maximum historical event marks", minval = 4, maxval = 100, group = GV)
bool zoneText = input.bool(true, "Show short zone names", group = GV)
int zoneFade = input.int(92, "Zone fill transparency", minval = 70, maxval = 100, group = GV)
int projection = input.int(8, "Extend current drawings (chart bars)", minval = 1, maxval = 50, group = GV)
color bullColor = input.color(color.teal, "Bullish / demand colour", group = GV)
color bearColor = input.color(color.maroon, "Bearish / supply colour", group = GV)
color neutralColor = input.color(color.gray, "Neutral / mixed colour", group = GV)

const string GE = "05 | Session entry candidates (optional)"
bool showCandidates = input.bool(false, "Show possible session entry zones", group = GE, tooltip = "Sweep -> later displaced break of the swing frozen at the sweep -> opposing-candle OB candidate. NOT a complete entry signal: no HTF POI validation, SL/TP or orders.")
bool highlightStarts = input.bool(false, "Highlight session starts", group = GE)
string sessionShade = input.string("Start bar only", "Highlight extent", options = ["Start bar only", "Opening window"], group = GE)
bool londonEnabled = input.bool(true, "London enabled", group = GE)
int londonHour = input.int(8, "London start hour", minval = 0, maxval = 23, group = GE, inline = "ldn")
int londonMinute = input.int(0, "Minute", minval = 0, maxval = 59, group = GE, inline = "ldn")
string londonTimezone = input.string("Europe/London", "London timezone", group = GE)
bool nyEnabled = input.bool(true, "New York enabled", group = GE)
int nyHour = input.int(8, "New York start hour", minval = 0, maxval = 23, group = GE, inline = "ny")
int nyMinute = input.int(0, "Minute", minval = 0, maxval = 59, group = GE, inline = "ny")
string nyTimezone = input.string("America/New_York", "New York timezone", group = GE)
int openingMinutes = input.int(60, "Opening window length (minutes)", minval = 5, maxval = 240, step = 5, group = GE)
string candidateFilter = input.string("Both HTFs agree", "Candidate direction filter", options = ["Both HTFs agree", "H4 only", "Unfiltered"], group = GE)
int setupLife = input.int(12, "Maximum bars from sweep to break", minval = 1, maxval = 50, group = GE)
float candidateBuffer = input.float(0.1, "Sweep invalidation buffer (ATR)", minval = 0, maxval = 2, step = 0.05, group = GE)

const string GQ = "06 | SMC buy/sell signals"
bool showSmcSignals = input.bool(true, "Show confirmed SMC BUY / SELL signals", group = GQ)
string smcEntryModel = input.string("Confirmation entry", "Entry model", options = ["Risk entry", "Confirmation entry"], group = GQ, tooltip = "Risk entry plans a limit at the new displacement FVG as soon as the shift is confirmed. Confirmation entry waits for a later engulfing or rejection candle after price returns to the entry zone.")
string riskPlacement = input.string("FVG 50%", "Risk-entry placement", options = ["FVG open boundary", "FVG 50%"], group = GQ)
bool requireHtfPoi = input.bool(true, "Require HTF 1 order block or FVG interaction", group = GQ, tooltip = "HTF 1 defaults to H1. This uses objective proxy zones derived from confirmed HTF candles; it is not a claim to reproduce any proprietary SMC implementation.")
bool requireSignalAlignment = input.bool(true, "Require H1 / H4 structure alignment", group = GQ)
bool requireEntryFvg = input.bool(true, "Require displacement to leave an entry FVG", group = GQ)
bool acceptEngulfing = input.bool(true, "Accept engulfing confirmation candle", group = GQ)
bool acceptRejection = input.bool(true, "Accept rejection / pin confirmation candle", group = GQ)
float rejectionWickRatio = input.float(1.5, "Minimum rejection wick / body", minval = 0.5, maxval = 5.0, step = 0.25, group = GQ)
float smcRewardRisk = input.float(3.0, "Target reward / risk", minval = 1.0, maxval = 10.0, step = 0.25, group = GQ)
bool showSmcLevels = input.bool(true, "Show entry, SL and TP levels", group = GQ)
bool enableSmcAlerts = input.bool(true, "Enable detailed SMC alert() calls", group = GQ)
color smcBuyColor = input.color(color.teal, "BUY signal colour", group = GQ)
color smcSellColor = input.color(color.red, "SELL signal colour", group = GQ)
color smcEntryColor = input.color(color.gray, "Entry line colour", group = GQ)
color smcStopColor = input.color(color.red, "SL line colour", group = GQ)
color smcTargetColor = input.color(color.teal, "TP line colour", group = GQ)

// Local calendar timestamps follow DST. Windows may cross midnight; weekdays
// refer to the opening date. Only fully contained chart bars qualify.
f_opening(string tz, int hh, int mm, bool enabled) =>
    int start = timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz), hh, mm)
    if time < start
        start := timestamp(tz, year(time, tz), month(time, tz), dayofmonth(time, tz) - 1, hh, mm)
    int finish = start + openingMinutes * 60000
    int weekday = dayofweek(start, tz)
    bool active = enabled and weekday >= dayofweek.monday and weekday <= dayofweek.friday and time >= start and time < finish and time_close <= finish
    [active, start, finish]
[inLondon, londonStart, londonEnd] = f_opening(londonTimezone, londonHour, londonMinute, londonEnabled)
[inNy, nyStart, nyEnd] = f_opening(nyTimezone, nyHour, nyMinute, nyEnabled)
// NY takes priority if customized windows overlap; never mix their sweep state.
int openingId = inNy ? 2 : inLondon ? 1 : 0
int openingKey = inNy ? nyStart : inLondon ? londonStart : 0
int openingEnd = inNy ? nyEnd : inLondon ? londonEnd : 0
bool openingChanged = openingId != openingId[1] or openingKey != openingKey[1]
bool startHighlight = (inLondon and (not inLondon[1] or londonStart != londonStart[1])) or (inNy and (not inNy[1] or nyStart != nyStart[1]))
bgcolor(highlightStarts and (sessionShade == "Opening window" ? openingId != 0 : startHighlight) ? color.new(color.silver, 94) : na, title = "Session opening highlight")

var int pendingDir = 0
var int sweepBar = na
var float sweepExtreme = na
var float sweepStop = na
var float frozenTrigger = na
var bool pendingPoiOk = false
var box candidateBox = na
var int candidateDir = 0
var int candidateBorn = na
var float candidateStop = na
var float candidateTop = na
var float candidateBottom = na
var float candidateEntryTop = na
var float candidateEntryBottom = na
var bool candidatePoiOk = false
var bool candidateTouched = false
var bool openingUsed = false
bool smcBuySignal = false
bool smcSellSignal = false
float smcSignalEntry = na
float smcSignalStop = na
float smcSignalTarget = na
string smcSignalModel = ""

if barstate.isfirst and (not timeframe.isintraday or timeframe.in_seconds() >= math.min(timeframe.in_seconds(htf1), timeframe.in_seconds(htf2)))
    runtime.error("Use an intraday chart below BOTH context timeframes, e.g. M5 with H1 and H4.")
if barstate.isfirst and not chart.is_standard
    runtime.error("Use standard OHLC candles; synthetic chart prices are not supported.")

// Latest confirmed HTF order-block and FVG proxies. These zones are calculated
// inside the requested timeframe and only become available when that HTF candle
// closes (request.security lookahead_off below).
f_htfPoi(int span, int search, float displacementFactor, float bodyShare, float gapFactor) =>
    float a = ta.atr(14)
    float r = high - low
    float priorHigh = ta.highest(high, span)[1]
    float priorLow = ta.lowest(low, span)[1]
    bool bullMove = close > open and close - open >= a * displacementFactor and r > 0 and (close - open) / r >= bodyShare
    bool bearMove = close < open and open - close >= a * displacementFactor and r > 0 and (open - close) / r >= bodyShare
    var float bullObTop = na
    var float bullObBottom = na
    var float bearObTop = na
    var float bearObBottom = na
    var float bullFvgTop = na
    var float bullFvgBottom = na
    var float bearFvgTop = na
    var float bearFvgBottom = na
    if not na(bullObBottom) and close < bullObBottom
        bullObTop := na
        bullObBottom := na
    if not na(bearObTop) and close > bearObTop
        bearObTop := na
        bearObBottom := na
    if not na(bullFvgBottom) and close < bullFvgBottom
        bullFvgTop := na
        bullFvgBottom := na
    if not na(bearFvgTop) and close > bearFvgTop
        bearFvgTop := na
        bearFvgBottom := na
    if bullMove and close > priorHigh
        for i = 1 to search
            if close[i] < open[i]
                bullObTop := high[i]
                bullObBottom := low[i]
                break
    if bearMove and close < priorLow
        for i = 1 to search
            if close[i] > open[i]
                bearObTop := high[i]
                bearObBottom := low[i]
                break
    float minimumGap = math.max(syminfo.mintick, a * gapFactor)
    if low > high[2] and low - high[2] >= minimumGap and bullMove[1]
        bullFvgTop := low
        bullFvgBottom := high[2]
    if high < low[2] and low[2] - high >= minimumGap and bearMove[1]
        bearFvgTop := low[2]
        bearFvgBottom := high
    [bullObTop, bullObBottom, bearObTop, bearObBottom, bullFvgTop, bullFvgBottom, bearFvgTop, bearFvgBottom]

int poiSpan = htfPivot * 2 + 1
[htfBullObTop, htfBullObBottom, htfBearObTop, htfBearObBottom, htfBullFvgTop, htfBullFvgBottom, htfBearFvgTop, htfBearFvgBottom] = request.security(syminfo.tickerid, htf1, f_htfPoi(poiSpan, obLookback, displacement, bodyFraction, gapMinimum), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)
f_zoneOverlap(float top, float bottom) =>
    not na(top) and not na(bottom) and high >= bottom and low <= top
bool inBullHtfPoi = f_zoneOverlap(htfBullObTop, htfBullObBottom) or f_zoneOverlap(htfBullFvgTop, htfBullFvgBottom)
bool inBearHtfPoi = f_zoneOverlap(htfBearObTop, htfBearObBottom) or f_zoneOverlap(htfBearFvgTop, htfBearFvgBottom)

// HTF state: latest confirmed swing close-break, not an EMA or a discretionary
// protected-swing algorithm. Process existing levels BEFORE admitting new pivots.
f_htf(int n) =>
    float ph = ta.pivothigh(high, n, n)
    float pl = ta.pivotlow(low, n, n)
    float a = ta.atr(14)
    var float sh = na
    var float sl = na
    var bool highBroken = false
    var bool lowBroken = false
    var int direction = 0
    float b = math.max(syminfo.mintick, a * breakBuffer)
    if not na(sh) and not highBroken and close > sh + b
        direction := 1
        highBroken := true
    else if not na(sl) and not lowBroken and close < sl - b
        direction := -1
        lowBroken := true
    if not na(ph)
        sh := ph
        highBroken := false
    if not na(pl)
        sl := pl
        lowBroken := false
    // Every returned series is offset IN the requested timeframe.
    [direction[1], sh[1], sl[1]]

[bias1, high1, low1] = request.security(syminfo.tickerid, htf1, f_htf(htfPivot), lookahead = barmerge.lookahead_on)
[bias2, high2, low2] = request.security(syminfo.tickerid, htf2, f_htf(htfPivot), lookahead = barmerge.lookahead_on)
int alignment = bias1 == 1 and bias2 == 1 ? 1 : bias1 == -1 and bias2 == -1 ? -1 : 0
f_candidateAligned(int dir) =>
    candidateFilter == "Unfiltered" or (candidateFilter == "H4 only" ? bias2 == dir : alignment == dir)
f_direction(int d) =>
    na(d) or d == 0 ? "Unconfirmed" : d == 1 ? "Bullish" : "Bearish"
f_tf(string tf) =>
    tf == "60" ? "H1" : tf == "240" ? "H4" : tf + " TF"
f_alignment() =>
    alignment == 1 ? "HTFs bullish" : alignment == -1 ? "HTFs bearish" : "HTFs mixed / unconfirmed"

type EventMark
    line level
    label note
    int day

type Zone
    box drawing
    float top
    float bottom
    int dir
    string kind
    int born
    int day
    bool touched = false
    bool reacted = false

type SmcPlan
    int dir
    int bornDay
    float entry
    float stop
    float target
    bool active
    line entryLine
    line stopLine
    line targetLine
    label caption
    string initialText

var array<EventMark> events = array.new<EventMark>()
var array<Zone> zones = array.new<Zone>()
var array<SmcPlan> smcPlans = array.new<SmcPlan>()
int dayKey = year(time, retentionZone) * 10000 + month(time, retentionZone) * 100 + dayofmonth(time, retentionZone)
var int dayNumber = 0
if barstate.isconfirmed and (barstate.isfirst or dayKey != dayKey[1])
    dayNumber += 1

f_mark(int startBar, float level, string caption, int dir, int day) =>
    color c = dir == 1 ? bullColor : bearColor
    line ln = line.new(math.max(startBar, bar_index - swingLife), level, bar_index, level, color = c, style = line.style_dotted)
    // Event label is on the actual confirmation bar, never on a past pivot.
    label lb = label.new(bar_index, level, caption, style = dir == 1 ? label.style_label_up : label.style_label_down, color = color.new(c, 15), textcolor = color.white, size = size.tiny)
    array.push(events, EventMark.new(ln, lb, day))

f_addZone(float top, float bottom, int dir, string kind, int day) =>
    // Retain at most zoneCount of each (kind, direction), deleting oldest first.
    int count = 0
    for z in zones
        if z.kind == kind and z.dir == dir
            count += 1
    if count >= zoneCount and array.size(zones) > 0
        for j = 0 to array.size(zones) - 1
            Zone z = array.get(zones, j)
            if z.kind == kind and z.dir == dir
                box.delete(z.drawing)
                array.remove(zones, j)
                break
    color c = dir == 1 ? bullColor : bearColor
    string caption = zoneText ? (dir == 1 ? "Demand " : "Supply ") + kind + " · " + timeframe.period : ""
    box bx = box.new(bar_index, top, bar_index + projection, bottom, border_color = color.new(c, 35), bgcolor = color.new(c, zoneFade), text = caption, text_color = c, text_size = size.tiny, text_halign = text.align_right)
    array.push(zones, Zone.new(bx, top, bottom, dir, kind, bar_index, day))

float atr = ta.atr(14)
float candleRange = high - low
bool bullDisplacement = close > open and close - open >= atr * displacement and candleRange > 0 and (close - open) / candleRange >= bodyFraction
bool bearDisplacement = close < open and open - close >= atr * displacement and candleRange > 0 and (open - close) / candleRange >= bodyFraction
float pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
float pivotLow = ta.pivotlow(low, pivotLength, pivotLength)
var float swingHigh = na
var float swingLow = na
var int highKnown = na
var int lowKnown = na
var int highOrigin = na
var int lowOrigin = na
var bool highUsed = false
var bool lowUsed = false
var bool highSwept = false
var bool lowSwept = false
var int chartBias = 0
bool bullishShift = false
bool bearishShift = false
bool highSweep = false
bool lowSweep = false
bool demandReaction = false
bool supplyReaction = false

if barstate.isconfirmed
    if array.size(smcPlans) > 0
        for i = array.size(smcPlans) - 1 to 0
            SmcPlan p = array.get(smcPlans, i)
            if p.active
                line.set_x2(p.entryLine, time_close)
                line.set_x2(p.stopLine, time_close)
                line.set_x2(p.targetLine, time_close)
                bool stopHit = p.dir == 1 ? low <= p.stop : high >= p.stop
                bool targetHit = p.dir == 1 ? high >= p.target : low <= p.target
                if stopHit or targetHit
                    p.active := false
                    string outcome = stopHit and targetHit ? "Both levels touched" : stopHit ? "SL touched" : "TP touched"
                    label.set_text(p.caption, p.initialText + "\n" + outcome)
                    label.set_color(p.caption, stopHit and targetHit ? color.gray : stopHit ? color.new(smcSellColor, 20) : color.new(smcBuyColor, 20))
            if not p.active and dayNumber - p.bornDay >= retainDays
                line.delete(p.entryLine)
                line.delete(p.stopLine)
                line.delete(p.targetLine)
                label.delete(p.caption)
                array.remove(smcPlans, i)
    // Existing zone lifecycle first. Formation candles cannot mitigate themselves.
    if array.size(zones) > 0
        for i = array.size(zones) - 1 to 0
            Zone z = array.get(zones, i)
            bool overlap = high >= z.bottom and low <= z.top
            bool expired = bar_index - z.born > zoneLife or dayNumber - z.day >= retainDays
            bool invalid = z.dir == 1 ? close < z.bottom : close > z.top
            bool farTouch = z.dir == 1 ? low <= z.bottom : high >= z.top
            bool remove = expired or invalid or (mitigation == "Wick reaches far edge" and farTouch) or (mitigation == "First touch" and overlap)
            bool rejection = overlap and (z.dir == 1 ? close > z.top and close > open : close < z.bottom and close < open)
            bool aligned = reactionFilter == "Annotate only" or alignment == z.dir
            // A first-touch removal can still record its valid rejection event.
            // A far-edge breach in wick-removal mode cannot generate a reaction.
            bool eventAllowed = not expired and not invalid and not (mitigation == "Wick reaches far edge" and farTouch)
            if showReactions and bar_index > z.born and not z.reacted and rejection and aligned and eventAllowed
                f_mark(bar_index, z.dir == 1 ? low : high, (z.dir == 1 ? "Demand reaction" : "Supply reaction") + "\n" + f_alignment(), z.dir, dayNumber)
                demandReaction := demandReaction or z.dir == 1
                supplyReaction := supplyReaction or z.dir == -1
                z.reacted := true
            if remove
                box.delete(z.drawing)
                array.remove(zones, i)
            else
                z.touched := z.touched or overlap
                box.set_right(z.drawing, bar_index + projection)
                box.set_border_style(z.drawing, z.touched ? line.style_dashed : line.style_solid)

    bool highLive = not na(swingHigh) and bar_index - highKnown <= swingLife
    bool lowLive = not na(swingLow) and bar_index - lowKnown <= swingLife
    float b = math.max(syminfo.mintick, atr * breakBuffer)
    float s = math.max(syminfo.mintick, atr * sweepBuffer)
    highSweep := highLive and not highUsed and not highSwept and high > swingHigh + s and close < swingHigh
    lowSweep := lowLive and not lowUsed and not lowSwept and low < swingLow - s and close > swingLow
    if highSweep
        highSwept := true
        if showSweeps
            f_mark(highKnown, swingHigh, "High swept", -1, dayNumber)
    if lowSweep
        lowSwept := true
        if showSweeps
            f_mark(lowKnown, swingLow, "Low swept", 1, dayNumber)

    int breakDir = highLive and not highUsed and close > swingHigh + b ? 1 : lowLive and not lowUsed and close < swingLow - b ? -1 : 0
    if breakDir != 0
        bool shift = chartBias != 0 and chartBias != breakDir
        bullishShift := shift and breakDir == 1
        bearishShift := shift and breakDir == -1
        string eventName = shift ? "CHoCH" : chartBias == 0 ? "Initial break" : "BOS"
        if (shift and showShift) or (not shift and showBos)
            f_mark(breakDir == 1 ? highKnown : lowKnown, breakDir == 1 ? swingHigh : swingLow, eventName + (breakDir == 1 ? " up" : " down"), breakDir, dayNumber)
        chartBias := breakDir
        if breakDir == 1
            highUsed := true
        else
            lowUsed := true
        // OB proxy: nearest opposing candle in the impulse's bounded search,
        // only when the structure-break candle itself has displacement.
        if showOb and (breakDir == 1 ? bullDisplacement : bearDisplacement)
            int sourceOrigin = breakDir == 1 ? lowOrigin : highOrigin
            for j = 1 to obLookback
                bool withinLeg = not na(sourceOrigin) and bar_index - j >= sourceOrigin
                bool opposing = breakDir == 1 ? close[j] < open[j] : close[j] > open[j]
                if withinLeg and opposing
                    float top = obBounds == "Full candle" ? high[j] : math.max(open[j], close[j])
                    float bottom = obBounds == "Full candle" ? low[j] : math.min(open[j], close[j])
                    bool departed = breakDir == 1 ? close > top : close < bottom
                    if departed and top > bottom
                        f_addZone(top, bottom, breakDir, "OB", dayNumber)
                    break

    if showFvg and bar_index >= 2
        float minGap = math.max(syminfo.mintick, atr * gapMinimum)
        if low > high[2] and low - high[2] >= minGap and bullDisplacement[1]
            f_addZone(low, high[2], 1, "FVG", dayNumber)
        if high < low[2] and low[2] - high >= minGap and bearDisplacement[1]
            f_addZone(low[2], high, -1, "FVG", dayNumber)

    // Session signal engine: one candidate and at most one signal per opening
    // window. It follows sweep -> displaced structure shift -> FVG/OB entry zone.
    bool runEntryEngine = showCandidates or showSmcSignals
    if openingChanged or openingId == 0 or not runEntryEngine
        pendingDir := 0
        pendingPoiOk := false
        box.delete(candidateBox)
        candidateBox := na
        candidateDir := 0
        candidateEntryTop := na
        candidateEntryBottom := na
        candidatePoiOk := false
        openingUsed := false
    if runEntryEngine and openingId != 0
        if candidateDir != 0
            bool stopHit = candidateDir == 1 ? low <= candidateStop : high >= candidateStop
            bool zoneFailed = candidateDir == 1 ? close < candidateBottom : close > candidateTop
            bool zoneTouchedNow = bar_index > candidateBorn and high >= candidateEntryBottom and low <= candidateEntryTop
            float confirmationBody = math.max(math.abs(close - open), syminfo.mintick)
            bool bullishEngulf = close > open and close >= open[1] and open <= close[1]
            bool bearishEngulf = close < open and close <= open[1] and open >= close[1]
            bool bullishReject = close > open and math.min(open, close) - low >= confirmationBody * rejectionWickRatio
            bool bearishReject = close < open and high - math.max(open, close) >= confirmationBody * rejectionWickRatio
            bool confirmationCandle = candidateDir == 1 ? (acceptEngulfing and bullishEngulf) or (acceptRejection and bullishReject) : (acceptEngulfing and bearishEngulf) or (acceptRejection and bearishReject)
            bool confirmationReady = showSmcSignals and smcEntryModel == "Confirmation entry" and zoneTouchedNow and confirmationCandle and candidatePoiOk and (not requireSignalAlignment or alignment == candidateDir)
            if stopHit or zoneFailed or not f_candidateAligned(candidateDir)
                box.delete(candidateBox)
                candidateBox := na
                candidateDir := 0
            else if confirmationReady
                float plannedEntry = close
                float riskDistance = candidateDir * (plannedEntry - candidateStop)
                if riskDistance > syminfo.mintick
                    smcBuySignal := candidateDir == 1
                    smcSellSignal := candidateDir == -1
                    smcSignalEntry := plannedEntry
                    smcSignalStop := candidateStop
                    smcSignalTarget := math.round_to_mintick(plannedEntry + candidateDir * riskDistance * smcRewardRisk)
                    smcSignalModel := "Confirmation"
                box.delete(candidateBox)
                candidateBox := na
                candidateDir := 0
            else
                candidateTouched := candidateTouched or zoneTouchedNow
                if showCandidates and not na(candidateBox)
                    box.set_right(candidateBox, math.min(time_close + projection * timeframe.in_seconds() * 1000, openingEnd))
                    box.set_border_style(candidateBox, candidateTouched ? line.style_dashed : line.style_solid)
        if pendingDir != 0
            bool invalidSetup = (pendingDir == 1 ? low <= sweepStop : high >= sweepStop) or bar_index - sweepBar > setupLife or not f_candidateAligned(pendingDir)
            if invalidSetup
                pendingDir := 0
                pendingPoiOk := false
        // Evaluate the swing frozen at the sweep. A valid signal candidate needs
        // a displaced break plus an opposing candle; the FVG gate is selectable.
        if pendingDir != 0 and bar_index > sweepBar
            bool triggerBroken = pendingDir == 1 ? close > frozenTrigger + b : close < frozenTrigger - b
            if triggerBroken
                if pendingDir == 1 ? bullDisplacement : bearDisplacement
                    float minimumEntryGap = math.max(syminfo.mintick, atr * gapMinimum)
                    bool bullEntryFvg = low > high[2] and low - high[2] >= minimumEntryGap and (bullDisplacement or bullDisplacement[1])
                    bool bearEntryFvg = high < low[2] and low[2] - high >= minimumEntryGap and (bearDisplacement or bearDisplacement[1])
                    bool hasEntryFvg = pendingDir == 1 ? bullEntryFvg : bearEntryFvg
                    float fvgTop = pendingDir == 1 ? low : low[2]
                    float fvgBottom = pendingDir == 1 ? high[2] : high
                    for j = 1 to obLookback
                        bool afterSweep = bar_index - j >= sweepBar
                        bool opposite = pendingDir == 1 ? close[j] < open[j] : close[j] > open[j]
                        if afterSweep and opposite
                            float obTop = obBounds == "Full candle" ? high[j] : math.max(open[j], close[j])
                            float obBottom = obBounds == "Full candle" ? low[j] : math.min(open[j], close[j])
                            bool departed = pendingDir == 1 ? close > obTop : close < obBottom
                            bool entryGate = not requireEntryFvg or hasEntryFvg
                            if departed and obTop > obBottom and entryGate and pendingPoiOk and time_close < openingEnd
                                float entryTop = hasEntryFvg ? fvgTop : obTop
                                float entryBottom = hasEntryFvg ? fvgBottom : obBottom
                                color c = pendingDir == 1 ? smcBuyColor : smcSellColor
                                string sessionName = openingId == 2 ? "NY" : "LDN"
                                if showCandidates
                                    candidateBox := box.new(time_close, entryTop, math.min(time_close + projection * timeframe.in_seconds() * 1000, openingEnd), entryBottom, xloc = xloc.bar_time, border_color = color.new(c, 35), bgcolor = color.new(c, 93), text = sessionName + (pendingDir == 1 ? " SMC buy zone" : " SMC sell zone"), text_color = c, text_size = size.tiny, text_halign = text.align_right)
                                candidateDir := pendingDir
                                candidateBorn := bar_index
                                candidateStop := sweepStop
                                candidateTop := entryTop
                                candidateBottom := entryBottom
                                candidateEntryTop := entryTop
                                candidateEntryBottom := entryBottom
                                candidatePoiOk := pendingPoiOk
                                candidateTouched := false
                                openingUsed := true
                                if showSmcSignals and smcEntryModel == "Risk entry"
                                    float plannedEntry = riskPlacement == "FVG 50%" ? math.avg(entryTop, entryBottom) : pendingDir == 1 ? entryTop : entryBottom
                                    float riskDistance = pendingDir * (plannedEntry - candidateStop)
                                    if riskDistance > syminfo.mintick
                                        smcBuySignal := pendingDir == 1
                                        smcSellSignal := pendingDir == -1
                                        smcSignalEntry := plannedEntry
                                        smcSignalStop := candidateStop
                                        smcSignalTarget := math.round_to_mintick(plannedEntry + pendingDir * riskDistance * smcRewardRisk)
                                        smcSignalModel := riskPlacement
                            break
                pendingDir := 0
                pendingPoiOk := false
        // A two-sided sweep is ambiguous. HTF POI and alignment are evaluated
        // at the sweep so a later break cannot retroactively qualify it.
        if not openingUsed and candidateDir == 0 and pendingDir == 0 and lowSweep != highSweep
            int dir = lowSweep ? 1 : -1
            bool triggerAvailable = dir == 1 ? highLive and not highUsed : lowLive and not lowUsed
            bool poiPass = not requireHtfPoi or (dir == 1 ? inBullHtfPoi : inBearHtfPoi)
            bool signalAlignmentPass = not requireSignalAlignment or alignment == dir
            if triggerAvailable and f_candidateAligned(dir) and poiPass and signalAlignmentPass
                pendingDir := dir
                pendingPoiOk := true
                sweepBar := bar_index
                sweepExtreme := dir == 1 ? low : high
                sweepStop := sweepExtreme - dir * math.max(syminfo.mintick, atr * candidateBuffer)
                frozenTrigger := dir == 1 ? swingHigh : swingLow

    if (smcBuySignal or smcSellSignal) and showSmcLevels and array.size(smcPlans) < 30
        int signalDir = smcBuySignal ? 1 : -1
        color signalColor = signalDir == 1 ? smcBuyColor : smcSellColor
        string signalText = (signalDir == 1 ? "BUY" : "SELL") + " | SMC " + smcSignalModel + "\nE " + str.tostring(smcSignalEntry, format.mintick) + "  SL " + str.tostring(smcSignalStop, format.mintick) + "\nTP " + str.tostring(smcSignalTarget, format.mintick) + " (" + str.tostring(smcRewardRisk) + "R)"
        int firstRight = time_close + int(timeframe.in_seconds() * 1000)
        line entryLine = line.new(time_close, smcSignalEntry, firstRight, smcSignalEntry, xloc = xloc.bar_time, color = smcEntryColor, style = line.style_dotted)
        line stopLine = line.new(time_close, smcSignalStop, firstRight, smcSignalStop, xloc = xloc.bar_time, color = smcStopColor)
        line targetLine = line.new(time_close, smcSignalTarget, firstRight, smcSignalTarget, xloc = xloc.bar_time, color = smcTargetColor)
        label signalLabel = label.new(time_close, signalDir == 1 ? low : high, signalText, xloc = xloc.bar_time, style = signalDir == 1 ? label.style_label_up : label.style_label_down, color = color.new(signalColor, 15), textcolor = color.white, size = size.small)
        array.push(smcPlans, SmcPlan.new(signalDir, dayNumber, smcSignalEntry, smcSignalStop, smcSignalTarget, true, entryLine, stopLine, targetLine, signalLabel, signalText))
    if (smcBuySignal or smcSellSignal) and enableSmcAlerts
        string alertSide = smcBuySignal ? "BUY" : "SELL"
        alert(alertSide + " | SMC " + smcSignalModel + " | " + syminfo.tickerid + " | TF " + timeframe.period + " | EST entry " + str.tostring(smcSignalEntry, format.mintick) + " SL " + str.tostring(smcSignalStop, format.mintick) + " TP " + str.tostring(smcSignalTarget, format.mintick) + " | Manual decision; not an order", alert.freq_all)

    // Admit pivots LAST: the confirming candle cannot also sweep/break a level
    // that was not available before this close. Swings are not back-labelled.
    if not na(pivotHigh)
        swingHigh := pivotHigh
        highKnown := bar_index
        highOrigin := bar_index - pivotLength
        highUsed := false
        highSwept := false
    if not na(pivotLow)
        swingLow := pivotLow
        lowKnown := bar_index
        lowOrigin := bar_index - pivotLength
        lowUsed := false
        lowSwept := false

    if array.size(events) > 0
        for i = array.size(events) - 1 to 0
            EventMark e = array.get(events, i)
            if dayNumber - e.day >= retainDays
                line.delete(e.level)
                label.delete(e.note)
                array.remove(events, i)
    while array.size(events) > eventLimit
        EventMark e = array.shift(events)
        line.delete(e.level)
        label.delete(e.note)

// Only the latest HTF range is drawn. It is the latest confirmed high/low pair,
// NOT a claim to the unique ICT dealing range or a protected-swing algorithm.
float rangeHigh = rangeSource == "HTF 1" ? high1 : high2
float rangeLow = rangeSource == "HTF 1" ? low1 : low2
float midpoint = math.avg(rangeHigh, rangeLow)
bool rangeValid = not na(rangeHigh) and not na(rangeLow) and rangeHigh > rangeLow
var int rangeKnown = na
if rangeValid and (na(rangeKnown) or rangeHigh != rangeHigh[1] or rangeLow != rangeLow[1])
    rangeKnown := bar_index
var line upper = na
var line middle = na
var line lower = na
var box premium = na
var box discount = na
var line highLiquidity = na
var line lowLiquidity = na
var label context = na
if barstate.islast
    line.delete(upper)
    line.delete(middle)
    line.delete(lower)
    box.delete(premium)
    box.delete(discount)
    line.delete(highLiquidity)
    line.delete(lowLiquidity)
    label.delete(context)
    int right = bar_index + projection
    if showRange and rangeValid
        int left = math.max(rangeKnown, bar_index - rangeLength)
        upper := line.new(left, rangeHigh, right, rangeHigh, color = color.new(bearColor, 40))
        middle := line.new(left, midpoint, right, midpoint, color = color.new(neutralColor, 40), style = line.style_dotted)
        lower := line.new(left, rangeLow, right, rangeLow, color = color.new(bullColor, 40))
        if shadeRange
            premium := box.new(left, rangeHigh, right, midpoint, border_color = na, bgcolor = color.new(bearColor, 96))
            discount := box.new(left, midpoint, right, rangeLow, border_color = na, bgcolor = color.new(bullColor, 96))
    if showLiquidity
        if not na(swingHigh) and not highUsed and not highSwept and bar_index - highKnown <= swingLife
            highLiquidity := line.new(highKnown, swingHigh, right, swingHigh, color = color.new(bearColor, 55), style = line.style_dotted)
        if not na(swingLow) and not lowUsed and not lowSwept and bar_index - lowKnown <= swingLife
            lowLiquidity := line.new(lowKnown, swingLow, right, swingLow, color = color.new(bullColor, 55), style = line.style_dotted)
    if showContext
        float confirmedClose = barstate.isconfirmed ? close : close[1]
        string locationText = not rangeValid ? "Range unavailable" : confirmedClose > rangeHigh ? "Above range" : confirmedClose < rangeLow ? "Below range" : confirmedClose > midpoint ? "Premium" : confirmedClose < midpoint ? "Discount" : "At 50%"
        string rangeTf = rangeSource == "HTF 1" ? htf1 : htf2
        string caption = f_tf(htf1) + ": " + f_direction(bias1) + " | " + f_tf(htf2) + ": " + f_direction(bias2) + "\n" + f_alignment() + " | " + f_tf(rangeTf) + " " + locationText
        color c = alignment == 1 ? bullColor : alignment == -1 ? bearColor : neutralColor
        context := label.new(bar_index + 2, confirmedClose, caption, style = label.style_label_left, color = color.new(chart.bg_color, 10), textcolor = c, size = size.small)

plotshape(smcBuySignal, "SMC qualified BUY", shape.triangleup, location.belowbar, smcBuyColor, text = "BUY", textcolor = smcBuyColor, size = size.tiny)
plotshape(smcSellSignal, "SMC qualified SELL", shape.triangledown, location.abovebar, smcSellColor, text = "SELL", textcolor = smcSellColor, size = size.tiny)

// Data Window values aid comparison without a dashboard or another price scale.
plot(bias1, "HTF 1 structure (+1 / -1 / 0)", display = display.data_window)
plot(bias2, "HTF 2 structure (+1 / -1 / 0)", display = display.data_window)
plot(chartBias, "Chart structure (+1 / -1 / 0)", display = display.data_window)
plot(rangeValid ? midpoint : na, "HTF range midpoint", display = display.data_window)
alertcondition(bullishShift, "Bullish chart CHoCH", "Confirmed bullish chart structure change on {{ticker}} {{interval}}. Context only, not an entry instruction.")
alertcondition(bearishShift, "Bearish chart CHoCH", "Confirmed bearish chart structure change on {{ticker}} {{interval}}. Context only, not an entry instruction.")
alertcondition(highSweep, "Swing high swept", "Confirmed swing-high sweep on {{ticker}} {{interval}}. Not a guaranteed reversal.")
alertcondition(lowSweep, "Swing low swept", "Confirmed swing-low sweep on {{ticker}} {{interval}}. Not a guaranteed reversal.")
alertcondition(demandReaction, "Demand-zone reaction", "Confirmed chart demand-zone rejection on {{ticker}} {{interval}}. Context only.")
alertcondition(supplyReaction, "Supply-zone reaction", "Confirmed chart supply-zone rejection on {{ticker}} {{interval}}. Context only.")
alertcondition(smcBuySignal, "SMC qualified BUY", "Confirmed SMC BUY on {{ticker}} {{interval}}. Use Any alert() function call for the estimated entry, SL and TP.")
alertcondition(smcSellSignal, "SMC qualified SELL", "Confirmed SMC SELL on {{ticker}} {{interval}}. Use Any alert() function call for the estimated entry, SL and TP.")
